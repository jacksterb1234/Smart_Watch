#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

#include "custom_smartwatch-pinctrl.dtsi"

/ {
	chosen {
		zephyr,bt-hci = &bt_hci_ipc0;
		zephyr,display = &display;
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 26 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW4";
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW5";
			zephyr,code = <INPUT_KEY_1>;
		};

		button2: button_2 {
			gpios = <&gpio1 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW6";
			zephyr,code = <INPUT_KEY_2>;
		};

		button3: button_3 {
			gpios = <&gpio1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW7";
			zephyr,code = <INPUT_KEY_3>;
		};
	};

	backlight {
		compatible = "gpio-leds";

		display_backlight: display_backlight {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
			label = "FAN5622 CTRL";
		};
	};

	haptic_enable {
		compatible = "gpio-leds";

		haptic_en: haptic_en {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "DRV2603 EN";
		};
	};

	haptic {
		compatible = "pwm-leds";

		haptic_pwm: haptic_pwm {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
	};

	aliases {
		i2c-0 = &i2c1;
		display-backlight = &display_backlight;
		haptic-en = &haptic_en;
		pwm-led0 = &haptic_pwm;
		sw0 = &button0;
		sw1 = &button1;
		sw2 = &button2;
		sw3 = &button3;
	};
};

&vregmain {
	status = "okay";
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregradio {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregh {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	pmic: npm1300@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		host-int-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
		pmic-int-pin = <1>;
		status = "okay";

		regulators {
			compatible = "nordic,npm1300-regulator";
			status = "okay";

			reg_1v8: BUCK1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			reg_3v0: BUCK2 {
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};
		};

		pmic_charger: charger {
			compatible = "nordic,npm1300-charger";
			status = "okay";
			term-microvolt = <4150000>;
			current-microamp = <100000>;
			dischg-limit-microamp = <1000000>;
			vbus-limit-microamp = <500000>;
			thermistor-ohms = <0>;
			thermistor-beta = <0>;
		};
	};

	bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
		irq-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	lps22df: lps22df@5c {
		compatible = "st,lps22df";
		reg = <0x5c>;
		drdy-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	max30102: max30102@57 {
		compatible = "maxim,max30101";
		reg = <0x57>;
		irq-gpios = <&gpio0 21 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		acq-mode = "spo2";
		smp-ave = <4>;
		adc-rge = <8192>;
		smp-sr = <50>;
		led-pw = <411>;
		led-pa = [24 24 00];
		fifo-rollover-en;
		status = "okay";
	};
};

&spi4 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi4_default>;
	pinctrl-1 = <&spi4_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		status = "okay";
		spi-dev = <&spi4>;
		dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		display: gc9a01@0 {
			compatible = "galaxycore,gc9x01x";
			reg = <0>;
			mipi-max-frequency = <DT_FREQ_M(32)>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
			width = <240>;
			height = <240>;
			display-inversion;
			status = "okay";
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	w25q32: w25q32jv@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		writeoc = "pp4io";
		readoc = "read4io";
		sck-frequency = <8000000>;
		jedec-id = [ef 40 16];
		size = <33554432>;
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd = <30000>;
		status = "okay";
	};
};
